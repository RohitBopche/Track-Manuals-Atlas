# Search-tool ignore list (ripgrep, and agents built on it). Not a git ignore: these files stay committed.
# They are generated by `python scripts/rebuild_all.py`, mostly as one very long line, so a single
# grep hit can return megabytes. Edit the generator in scripts/, never these files; open one
# explicitly by path if you really need to look inside.
data/rdso_kg_data.js
data/rdso_canonical_kg.json
data/manual_content_index.js
data/search/*.js
data/knowledge-graph/exports/
data/knowledge-graph/raw/
data/knowledge-graph/intermediate/
data/knowledge-graph/canonical/*.jsonl
